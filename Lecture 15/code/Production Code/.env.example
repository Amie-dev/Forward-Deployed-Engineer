# Lecture 15 — MCP Server: Resources and Prompts (Production Code)
#
# Copy to `.env` and adjust. Every value below is declared once, validated once
# and typed once by `src/config/env.ts`. An invalid value stops the process at
# boot instead of surfacing three turns into a conversation.

# --- Identity (Notes Ch01 §1.6 — what `initialize` advertises) --------------
MCP_SERVER_NAME=task-mcp-server
MCP_SERVER_VERSION=1.0.0

# --- Transport (Notes Ch03 — one server, one standard door) -----------------
# The server is bound to Streamable HTTP so a host can reach it over the wire.
MCP_SERVER_PORT=8081
MCP_HOST_PORT=8080
MCP_SERVER_URL=http://127.0.0.1:8081/mcp

# --- Observability ---------------------------------------------------------
MCP_LOG_LEVEL=info

# --- Execution guards ------------------------------------------------------
# `prompts/get` is a local template render; `resources/read` may hit a backend;
# the two budgets are therefore different on purpose (Notes Ch07 §"budgets").
MCP_TOOL_TIMEOUT_MS=5000
MCP_RESOURCE_TIMEOUT_MS=2000
MCP_RATE_LIMIT_PER_MINUTE=60

# --- Context budgets (Notes Ch02 §"Size and token budget", Ch05 §"budget") ---
# Three separate caps, because one runaway document must not be able to eat the
# whole prompt, and ten small ones must not be able to either.
MCP_MAX_RESOURCES_PER_REQUEST=3
MCP_MAX_RESOURCE_CHARS=20000
MCP_MAX_CONTEXT_CHARS=40000

# --- Resource caching (Notes Ch04 §"Cache like a read-heavy system") --------
# Static resources are cached for the process lifetime; dynamic ones get a TTL.
MCP_RESOURCE_CACHE_TTL_MS=30000

# --- Resource safety (Notes Ch03 §"URI is an identifier", Ch04 §"authorise") -
# Only these URI schemes may be read. Anything else is refused before it
# reaches a handler, so a template cannot become an enumeration oracle.
MCP_ALLOWED_RESOURCE_SCHEMES=task,user

# --- Domain limits ---------------------------------------------------------
MCP_MAX_TASKS=1000

# --- Host policy (Notes Ch04 §"authorisation", Ch06 §"keep the count small") --
# Discovery is an inventory, not a grant: these decide what the host will show.
#   false -> destructive tools are never even shown to the model
#   true  -> they are shown, but still require explicit user consent
MCP_HOST_ALLOW_DESTRUCTIVE=true
MCP_HOST_REQUIRE_CONSENT=true
# Comma-separated prompt names to offer. Empty means "every registered prompt".
MCP_HOST_ALLOWED_PROMPTS=

# --- The model step (Notes Ch07 §7.3 — after `prompts/get`, never inside it) -
# Leave the key empty and the host prints the assembled prompt instead of
# calling a model, so the whole Resource + Prompt half of the protocol stays
# reproducible on any machine with no credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
