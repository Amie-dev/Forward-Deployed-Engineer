# ==============================================================================
# Root .gitignore for Forward Deployed Engineer Workspace
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & API Credentials (SECURITY CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.crt
# Keep example templates tracked in version control
!.env.example

# ------------------------------------------------------------------------------
# 2. Node.js & TypeScript
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/
.serverless/
.fusebox/
.dynamodb/

# TypeScript build info cache
*.tsbuildinfo

# Package manager logs & lock cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Python (Virtual Environments & Bytecode)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Java & Build Tools (Maven / Gradle)
# ------------------------------------------------------------------------------
target/
*.class
*.jar
*.war
*.ear
.gradle/
gradle-app.setting
!gradle-wrapper.jar

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux / Vim / Emacs
*~
*.swp
*.swo
*.tmp

# JetBrains / IntelliJ IDEA
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 6. Miscellaneous Temporary Caches & Dumps
# ------------------------------------------------------------------------------
.cache/
tmp/
temp/
*.log
