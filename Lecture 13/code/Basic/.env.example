# ─────────────────────────────────────────────────────────────
# Lecture 13 — Structured Outputs.  Every value below has a
# default, so `npm run naive` works with this file absent.
# ─────────────────────────────────────────────────────────────

# Provider. "auto" = use OpenAI if OPENAI_API_KEY exists, else the
# offline simulator. The simulator is not a language model: it
# reproduces the *documented* failure modes so every chapter of the
# notes is testable on any machine, with or without a key.
LLM_PROVIDER=auto                # auto | openai | simulate
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini

# ── Chapter 03/05: which enforcement layer the call uses ────
# instruction | json_mode | schema | validate
#   instruction  "Return JSON" in the prompt        (guarantees nothing)
#   json_mode    response_format json_object        (syntax only)
#   schema       response_format json_schema strict (shape, by construction)
#   validate     schema + runtime validation        (nothing invalid passes)
ENFORCEMENT=validate

# ── Chapter 04: schema behaviour ────────────────────────────
SCHEMA_VERSION=meeting.v2
STRICT_SCHEMA=true               # close every object, require every field

# ── Chapter 06: the reliability loop ────────────────────────
MAX_REPAIRS=2                    # bounded: 1-2 is usually enough
REPAIR_TEMPERATURE=0             # determinism on repair, not creativity
TEMPERATURE=0.2                  # first attempt
ALLOW_DEGRADED_FALLBACK=true     # fill unknowns with null instead of failing

# ── Chapter 06/08: semantics and actions ────────────────────
MAX_DURATION_MINUTES=480         # anything longer is a semantic error
MAX_DURATION_REVIEW_MINUTES=240  # longer than this is flagged for review
REQUIRE_FUTURE_START=true        # a start in the past is a blocking error

# ── Chapter 07/08: action safety ────────────────────────────
AUTO_APPROVE_MAX_DURATION=120    # above this, a human confirms (tier 3)
ACTOR_ID=aditya@northwind.test
DIRECTORY=aditya@northwind.test,ravi@northwind.test,priya@northwind.test

# ── Chapter 09: evaluation ──────────────────────────────────
EVAL_MIN_FIRST_PASS=0.80         # release gate: first-pass validity

# ── Server ──────────────────────────────────────────────────
PORT=3200
